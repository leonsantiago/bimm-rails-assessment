<%= form_with url: screenings_path, method: :get, data: { turbo_frame: "screenings" }, class: "w-full flex flex-wrap items-end gap-4 mb-6 p-4 sm:p-5 bg-gray-50 rounded-lg border border-gray-200" do |f| %>
  <div class="flex flex-col w-full sm:w-44 sm:shrink-0">
    <%= f.label :date, "Date", class: "text-sm font-medium text-gray-700 mb-1.5" %>
    <%= f.date_field :date, value: params[:date], class: "h-10 w-full rounded-md border border-gray-300 bg-white px-3 text-sm shadow-sm" %>
  </div>

  <div class="flex flex-col w-full sm:w-56 sm:shrink-0">
    <%= f.label :venue_id, "Venue", class: "text-sm font-medium text-gray-700 mb-1.5" %>
    <%= f.select :venue_id,
          options_from_collection_for_select(venues, :id, :name, params[:venue_id]),
          { include_blank: "All venues" },
          class: "h-10 w-full rounded-md border border-gray-300 bg-white px-3 text-sm shadow-sm" %>
  </div>

  <div class="flex flex-col w-full sm:w-64 sm:shrink-0">
    <%= f.label :q, "Search titles", class: "text-sm font-medium text-gray-700 mb-1.5" %>
    <%= f.text_field :q, value: params[:q], placeholder: "e.g. Autumn", class: "h-10 w-full rounded-md border border-gray-300 bg-white px-3 text-sm shadow-sm" %>
  </div>

  <%= f.submit "Filter", class: "ml-auto h-10 rounded-md bg-gray-900 px-4 py-2 text-sm text-white font-medium hover:bg-gray-700 cursor-pointer" %>
<% end %>
