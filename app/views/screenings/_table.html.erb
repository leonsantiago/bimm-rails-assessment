<div class="overflow-x-auto rounded-lg border border-gray-200">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Film</th>
        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Venue</th>
        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Starts</th>
        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Status</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100 bg-white">
      <% screenings.each do |screening| %>
        <tr>
          <td class="px-4 py-3 text-sm font-medium text-gray-900"><%= screening.film.title %></td>
          <td class="px-4 py-3 text-sm text-gray-700"><%= screening.venue.name %></td>
          <td class="px-4 py-3 text-sm text-gray-700"><%= screening.starts_at.in_time_zone.strftime("%a %d %b, %-l:%M%P") %></td>
          <td class="px-4 py-3 text-sm">
            <% if screening.cancelled? %>
              <span class="inline-flex rounded-full bg-red-100 px-2 text-xs font-semibold leading-5 text-red-800">Cancelled</span>
            <% else %>
              <span class="inline-flex rounded-full bg-green-100 px-2 text-xs font-semibold leading-5 text-green-800">Scheduled</span>
            <% end %>
          </td>
        </tr>
      <% end %>

      <% if screenings.empty? %>
        <tr><td colspan="4" class="px-4 py-8 text-center text-gray-400">No screenings match your filters.</td></tr>
      <% end %>
    </tbody>
  </table>
</div>
